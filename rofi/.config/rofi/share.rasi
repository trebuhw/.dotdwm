* {
  border: 0;
  margin: 0;
  padding: 0;
  spacing: 0;

  urgent: #f38ba8;   /* Catppuccin Mocha Red */
  active: #89b4fa;   /* Catppuccin Mocha Blue */
  bg: #1e1e2e;        /* Catppuccin Mocha Base */
  bg-alt: #313244;    /* Catppuccin Mocha Surface0 */
  fg: #cdd6f4;         /* Catppuccin Mocha Text */
  fg-alt: #b4befe;    /* Catppuccin Mocha Lavender */
  selected: @fg-alt;
  background-color: @bg;
  text-color: @fg;
}
configuration {
  font: "JetBrains Mono Nerd Font 12";
  terminal: "ghostty";

  combi {
    display-name: "󰍜";
  }

  drun {
    display-name: "󱩾";
  }

  run {
    display-name: "";
  }

  window {
    display-name: "";
  }

  timeout {
    delay: 10;
    action: "kb-cancel";
  }

  filebrowser {
    display-name: "";
  }

  display-drun: "Application:";
  display-window: "Window:";
  display-filebrowser: "Files:";
  case-sensitive: false;
  sort: true;
  sorting-method: "fzf";
  modi: [
    "run",
    "drun",
    "window"
  ];
  show-icons: true;
  terminal: "ghostty";
}

window {
    /* properties for window widget */
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       600px;
    x-offset:                    0px;
    y-offset:                    0px;

    /* properties for all widgets */
    font:                        "JetBrains Mono Nerd Font 12";
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      1px solid;
    border-radius:               0px;
    border-color:                @active;
    cursor:                      "default";
    background-color:            @bg;
}
