#!/bin/bash
# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

if [ -z "$1" ]; then
  echo "Usage: $0 <url>" >&2
  exit 1
fi

browser=$(xdg-settings get default-web-browser)

case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium* | chromium*)
  ;;
*)
  browser="chromium-browser.desktop"
  ;;
esac

binary=$(sed -n 's/^Exec=\([^ ]*\).*/\1/p' \
  ~/.local/share/applications/$browser \
  /usr/share/applications/$browser \
  2>/dev/null | head -1)

if [ -z "$binary" ]; then
  echo "Nie znaleziono przeglądarki: $browser" >&2
  exit 1
fi

exec "$binary" --app="$1" "${@:2}"
